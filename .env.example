# CourseForge Course Creator App - Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# IMPORTANT SECURITY NOTES:
# - Never commit .env files to version control
# - Only use the ANON key in frontend applications (never service_role key)
# - The anon key is safe to expose in frontend code as it's protected by RLS policies
# - Keep your service_role key secure and only use it in backend/edge functions
